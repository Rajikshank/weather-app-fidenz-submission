# Browser-side Auth0 settings. Use a Regular Web Application / SPA configured
# for Authorization Code + PKCE and keep public signup disabled in Auth0.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://api.ocucomfort.app
VITE_AUTH_MODE=auth0

# Worker secrets belong in `.dev.vars` locally and `wrangler secret put` in prod.
OPENWEATHER_API_KEY=replace-me
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.ocucomfort.app
DATA_MODE=live
