{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocucomfort",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "AUTH_MODE": "auth0",
    "DATA_MODE": "live"
  },
  "env": {
    "e2e": {
      "vars": {
        "AUTH_MODE": "demo",
        "DATA_MODE": "demo"
      }
    }
  }
}
